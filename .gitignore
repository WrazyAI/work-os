# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# deploy marker
/.deployed-commit
/.runner-deployed-commit

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
!.env.example
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent-local working state: skills installed for the agent, the Neon CLI
# config, TestSprite run artifacts, and nested worktrees. None of these belong
# in the repository, and one of them is a symlink into another agent's
# worktree, so a blanket `git add -A` must never sweep them in.
/.agents/
/.claude/
/.neon
/.testsprite/
/.worktrees/
