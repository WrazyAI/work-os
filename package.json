{
  "name": "agentic-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "runner": "tsx scripts/agent-runner.ts",
    "redeploy": "bash scripts/redeploy.sh",
    "work-os:verify-ai-stack": "node --import tsx scripts/verify-ai-stack-live.mts",
    "work-os:measure-prompt-cache": "node --import tsx scripts/measure-prompt-cache.mts",
    "db:apply": "node scripts/apply-migration.mjs",
    "db:apply:work-os": "node scripts/apply-work-os-migration.mjs",
    "work-os:pilot-audit": "node --import tsx scripts/work-os-pilot-audit.ts",
    "work-os:typecheck": "tsc --noEmit -p tsconfig.work-os.json",
    "work-os:test": "node scripts/run-work-os-tests.mjs --suite=work-os",
    "work-os:test:core": "node scripts/run-work-os-tests.mjs --suite=core",
    "work-os:test:payroll": "node scripts/run-work-os-tests.mjs --suite=payroll",
    "work-os:test:site": "node scripts/run-work-os-tests.mjs --suite=site",
    "companion:release:status": "node scripts/work-os-companion-release-gate.mjs status",
    "lint": "eslint src",
    "db:verify": "node scripts/dryrun-migration.mjs && node scripts/dryrun-data.mjs && node scripts/dryrun-rls.mjs",
    "migrate:data": "tsx scripts/migrate-vault.ts",
    "test:e2e:seo-approvals": "node scripts/verify-seo-approval-flow.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@lottiefiles/dotlottie-web": "^0.80.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.101.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.28",
    "gsap": "3.14.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.6",
    "js-yaml": "^4.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
