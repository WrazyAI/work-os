{
  "name": "agentic-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "runner": "tsx scripts/agent-runner.ts",
    "redeploy": "bash scripts/redeploy.sh",
    "db:apply": "node scripts/apply-migration.mjs",
    "db:apply:work-os": "node scripts/apply-work-os-migration.mjs",
    "work-os:pilot-audit": "node --import tsx scripts/work-os-pilot-audit.ts",
    "work-os:typecheck": "tsc --noEmit -p tsconfig.work-os.json",
    "work-os:test": "node --test test/work-os-migration.test.mjs && node --import tsx --test test/work-os-attribution.test.mts test/work-os-companion.test.mts test/work-os-provider-secrets.test.mts test/work-os-provider-webhooks.test.mts test/work-os-readiness.test.mts test/work-os-route-contracts.test.mts test/work-os-schedule-validation.test.mts test/work-os-screenshot-crypto.test.mts",
    "db:verify": "node scripts/dryrun-migration.mjs && node scripts/dryrun-data.mjs && node scripts/dryrun-rls.mjs",
    "migrate:data": "tsx scripts/migrate-vault.ts",
    "test:e2e:seo-approvals": "node scripts/verify-seo-approval-flow.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.0",
    "@types/js-yaml": "^4.0.9",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "google-trends-api": "^4.9.2",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "three": "^0.184.0",
    "three-spritetext": "^1.10.0",
    "tus-js-client": "^4.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
