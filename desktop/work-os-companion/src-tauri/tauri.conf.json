{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Work OS Companion",
  "version": "0.3.58",

  "identifier": "com.wrazy.workos.pilot",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Work OS",
        "width": 1000,
        "height": 960,
        "minWidth": 720,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "useHttpsScheme": true
      },
      {
        "label": "debug",
        "title": "Work OS Debugger",
        "url": "debug.html",
        "width": 760,
        "height": 860,
        "minWidth": 520,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "resizable": true,
        "useHttpsScheme": true
      },
      {
        "label": "avatar",
        "title": "Work OS Companion",
        "url": "index.html?window=avatar",
        "width": 200,
        "height": 276,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' https: ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/worktivity-controller.ps1"],
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "wrazy-workos"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0RTBEOEY2RkJEODg4RgpSV1NQaUwxdmp3MU9DUEYwL0N6MExMeTFpdmdmdDdQemVsa3Z0a2NaZWcydWdPOTJldEJ0eW1vTgo=",
      "endpoints": [
        "https://app.wrazyos.com/api/work-os/desktop/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
