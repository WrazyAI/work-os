{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities required by the packaged Work OS employee companion.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:path:default",
    "autostart:default",
    "deep-link:default",
    "notification:default",
    "opener:default",
    "allow-app-commands",
    "process:allow-restart",
    "stronghold:default",
    "stronghold:allow-remove-store-record",
    "updater:default"
  ]
}
