{
  "name": "@wrazy/work-os-companion",
  "version": "0.4.89",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build --bundles nsis,msi",
    "tauri:build:macos": "tauri build --config src-tauri/tauri.macos.conf.json --target universal-apple-darwin --bundles app,dmg",
    "tauri:dev:macos": "tauri dev --config src-tauri/tauri.dev.conf.json --config src-tauri/tauri.macos.conf.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@lottiefiles/dotlottie-web": "^0.80.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-deep-link": "^2.4.0",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-stronghold": "^2.3.0",
    "@tauri-apps/plugin-updater": "2.10.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
